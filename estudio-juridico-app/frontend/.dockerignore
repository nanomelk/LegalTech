# ─────────────────────────────────────────────────────────────────
# .dockerignore — Frontend
# ─────────────────────────────────────────────────────────────────

# Dependencias de Node (se reinstalan dentro del contenedor)
node_modules/

# Build anterior (se regenera)
dist/

# Archivos de entorno locales
.env
.env.local
.env.*.local

# Caché de herramientas
.vite/
.cache/

# IDE y sistema operativo
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Documentación y configuración de git
DOCS.md
*.md
.git/
.gitignore

# Logs
*.log
npm-debug.log*
